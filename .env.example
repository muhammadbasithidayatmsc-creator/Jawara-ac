# JAWARA AC — KONFIGURASI SERVER & SQLITE PERSISTEN

# Port server Express (default: 3000)
PORT=3000

# Direktori penyimpanan file database SQLite (jawara_ac.db)
# Pada hosting produksi (Railway/Render/Fly/VPS), arahkan ke path Persistent Volume (misal: /app/data)
DATA_DIR=./data

# Kunci rahasia penandatanganan token sesi Admin (isi string acak panjang di produksi)
SESSION_SECRET=

# Opsional: Inisialisasi otomatis akun Admin pertama saat startup jika belum ada Admin di SQLite.
# Jika dikosongkan, halaman login otomatis menampilkan form aktivasi Admin pertama.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin JAWARA AC
